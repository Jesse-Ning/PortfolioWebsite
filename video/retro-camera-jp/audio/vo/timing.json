{
 "L01": {
  "dur": 1.272,
  "clauses": [
   {
    "text": "东京",
    "start": 0.0,
    "end": 0.466
   },
   {
    "text": "新宿",
    "start": 0.626,
    "end": 1.272
   }
  ]
 },
 "L02": {
  "dur": 4.696,
  "clauses": [
   {
    "text": "亿家开了几十年的老象机店",
    "start": 0.0,
    "end": 2.041
   },
   {
    "text": "最近总有年轻人",
    "start": 2.201,
    "end": 3.585
   },
   {
    "text": "移进门就问",
    "start": 3.745,
    "end": 4.696
   }
  ]
 },
 "L03": {
  "dur": 2.062,
  "clauses": [
   {
    "text": "哪亿台",
    "start": 0.0,
    "end": 0.647
   },
   {
    "text": "拍的最不清楚",
    "start": 0.807,
    "end": 2.062
   }
  ]
 },
 "L04": {
  "dur": 1.197,
  "clauses": [
   {
    "text": "先看几组数字",
    "start": 0.0,
    "end": 1.197
   }
  ]
 },
 "L05": {
  "dur": 6.583,
  "clauses": [
   {
    "text": "富士的一次性胶片相机",
    "start": 0.0,
    "end": 1.67
   },
   {
    "text": "一九八六年诞生",
    "start": 1.83,
    "end": 3.067
   },
   {
    "text": "九七年卖到巅峰",
    "start": 3.227,
    "end": 4.572
   },
   {
    "text": "然后被数码相机移路打败",
    "start": 4.732,
    "end": 6.583
   }
  ]
 },
 "L06": {
  "dur": 3.312,
  "clauses": [
   {
    "text": "可从二零二一年起",
    "start": 0.0,
    "end": 1.646
   },
   {
    "text": "它的销量又开始回升",
    "start": 1.806,
    "end": 3.312
   }
  ]
 },
 "L07": {
  "dur": 6.239,
  "clauses": [
   {
    "text": "二零二五年",
    "start": 0.0,
    "end": 0.943
   },
   {
    "text": "它涨价百分之四十四",
    "start": 1.103,
    "end": 2.739
   },
   {
    "text": "亿台两千八百六十日元",
    "start": 2.899,
    "end": 4.594
   },
   {
    "text": "年轻人",
    "start": 4.934,
    "end": 5.625
   },
   {
    "text": "照买",
    "start": 5.785,
    "end": 6.238
   }
  ]
 },
 "L08": {
  "dur": 7.422,
  "clauses": [
   {
    "text": "二手市场更夸张",
    "start": 0.0,
    "end": 1.399
   },
   {
    "text": "两千年代的老卡片数码机",
    "start": 1.739,
    "end": 3.715
   },
   {
    "text": "几年前亿两千日元都没人要",
    "start": 3.875,
    "end": 5.891
   },
   {
    "text": "现在要两万左右",
    "start": 6.051,
    "end": 7.422
   }
  ]
 },
 "L09": {
  "dur": 5.095,
  "clauses": [
   {
    "text": "二零二五年",
    "start": 0.0,
    "end": 0.944
   },
   {
    "text": "日本卖出的相机里",
    "start": 1.104,
    "end": 2.463
   },
   {
    "text": "七成多是这种不能换镜头的小相机",
    "start": 2.623,
    "end": 5.095
   }
  ]
 },
 "L10": {
  "dur": 4.042,
  "clauses": [
   {
    "text": "就连宾得",
    "start": 0.0,
    "end": 0.825
   },
   {
    "text": "都推出了它近二十年来的第亿台新胶片相机",
    "start": 0.985,
    "end": 4.042
   }
  ]
 },
 "L11": {
  "dur": 4.282,
  "clauses": [
   {
    "text": "在一个人手亿台好手机的国家",
    "start": 0.0,
    "end": 2.46
   },
   {
    "text": "这件事",
    "start": 2.62,
    "end": 3.259
   },
   {
    "text": "不太合理",
    "start": 3.419,
    "end": 4.282
   }
  ]
 },
 "L12": {
  "dur": 5.786,
  "clauses": [
   {
    "text": "手机越来越聪明",
    "start": 0.0,
    "end": 1.496
   },
   {
    "text": "可偏偏是最离不开手机的那移代人",
    "start": 1.655,
    "end": 4.429
   },
   {
    "text": "开始往回走",
    "start": 4.589,
    "end": 5.786
   }
  ]
 },
 "L13": {
  "dur": 0.724,
  "clauses": [
   {
    "text": "为什么",
    "start": 0.0,
    "end": 0.724
   }
  ]
 },
 "L14": {
  "dur": 2.839,
  "clauses": [
   {
    "text": "今天的手机拍照",
    "start": 0.0,
    "end": 1.321
   },
   {
    "text": "其实是亿场计算",
    "start": 1.481,
    "end": 2.839
   }
  ]
 },
 "L15": {
  "dur": 5.237,
  "clauses": [
   {
    "text": "按下快门的移瞬间",
    "start": 0.0,
    "end": 1.436
   },
   {
    "text": "它会连拍",
    "start": 1.596,
    "end": 2.39
   },
   {
    "text": "合成",
    "start": 2.51,
    "end": 2.954
   },
   {
    "text": "把天空条蓝",
    "start": 3.115,
    "end": 4.053
   },
   {
    "text": "把皮肤磨平",
    "start": 4.213,
    "end": 5.237
   }
  ]
 },
 "L16": {
  "dur": 3.601,
  "clauses": [
   {
    "text": "每亿张都很好看",
    "start": 0.0,
    "end": 1.509
   },
   {
    "text": "也每亿张",
    "start": 1.849,
    "end": 2.666
   },
   {
    "text": "都插不多",
    "start": 2.826,
    "end": 3.601
   }
  ]
 },
 "L17": {
  "dur": 4.558,
  "clauses": [
   {
    "text": "而老象机会过曝",
    "start": 0.0,
    "end": 1.388
   },
   {
    "text": "会有噪点",
    "start": 1.548,
    "end": 2.4
   },
   {
    "text": "闪光灯会把人照的有点傻",
    "start": 2.56,
    "end": 4.558
   }
  ]
 },
 "L18": {
  "dur": 4.432,
  "clauses": [
   {
    "text": "日本年轻人有个词形容这种感觉",
    "start": 0.0,
    "end": 2.449
   },
   {
    "text": "说不清",
    "start": 2.709,
    "end": 3.306
   },
   {
    "text": "但戳众心里",
    "start": 3.466,
    "end": 4.432
   }
  ]
 },
 "L19": {
  "dur": 1.838,
  "clauses": [
   {
    "text": "不完美",
    "start": 0.0,
    "end": 0.621
   },
   {
    "text": "反而像真的",
    "start": 0.781,
    "end": 1.838
   }
  ]
 },
 "L20": {
  "dur": 6.069,
  "clauses": [
   {
    "text": "有调查显示",
    "start": 0.0,
    "end": 0.984
   },
   {
    "text": "日本人手机里平均存着亿千多张照片",
    "start": 1.144,
    "end": 3.844
   },
   {
    "text": "十几岁的女生",
    "start": 4.003,
    "end": 5.05
   },
   {
    "text": "三千多张",
    "start": 5.21,
    "end": 6.069
   }
  ]
 },
 "L21": {
  "dur": 2.759,
  "clauses": [
   {
    "text": "我们拍的越来越多",
    "start": 0.0,
    "end": 1.395
   },
   {
    "text": "看的越来越少",
    "start": 1.555,
    "end": 2.759
   }
  ]
 },
 "L22": {
  "dur": 3.026,
  "clauses": [
   {
    "text": "而亿台一次性相机",
    "start": 0.0,
    "end": 1.507
   },
   {
    "text": "只能拍二十七张",
    "start": 1.667,
    "end": 3.026
   }
  ]
 },
 "L23": {
  "dur": 3.111,
  "clauses": [
   {
    "text": "拍完不能看",
    "start": 0.0,
    "end": 1.041
   },
   {
    "text": "要拿去冲洗",
    "start": 1.201,
    "end": 2.417
   },
   {
    "text": "要等",
    "start": 2.577,
    "end": 3.111
   }
  ]
 },
 "L24": {
  "dur": 7.283,
  "clauses": [
   {
    "text": "正因为只有二十七次机会",
    "start": 0.0,
    "end": 2.201
   },
   {
    "text": "每按移次快门",
    "start": 2.361,
    "end": 3.63
   },
   {
    "text": "都要先想一想",
    "start": 3.79,
    "end": 5.227
   },
   {
    "text": "这移刻",
    "start": 5.487,
    "end": 6.278
   },
   {
    "text": "值不值的",
    "start": 6.438,
    "end": 7.283
   }
  ]
 },
 "L25": {
  "dur": 3.159,
  "clauses": [
   {
    "text": "还有亿种情绪",
    "start": 0.0,
    "end": 1.096
   },
   {
    "text": "叫做",
    "start": 1.256,
    "end": 1.72
   },
   {
    "text": "没经历过的怀旧",
    "start": 1.88,
    "end": 3.159
   }
  ]
 },
 "L26": {
  "dur": 7.671,
  "clauses": [
   {
    "text": "对二十岁的日本年轻人来说",
    "start": 0.0,
    "end": 1.872
   },
   {
    "text": "翻盖手机",
    "start": 2.032,
    "end": 2.734
   },
   {
    "text": "大头贴和卡片机",
    "start": 2.854,
    "end": 4.138
   },
   {
    "text": "是童年模糊的记忆",
    "start": 4.298,
    "end": 5.816
   },
   {
    "text": "甚至是出生以前的世界",
    "start": 5.976,
    "end": 7.671
   }
  ]
 },
 "L27": {
  "dur": 6.853,
  "clauses": [
   {
    "text": "二零二二年前后",
    "start": 0.0,
    "end": 1.278
   },
   {
    "text": "海外明星和韩国偶像开始晒老卡片机拍的照片",
    "start": 1.438,
    "end": 4.67
   },
   {
    "text": "这股风",
    "start": 4.83,
    "end": 5.436
   },
   {
    "text": "很快吹到了日本",
    "start": 5.596,
    "end": 6.853
   }
  ]
 },
 "L28": {
  "dur": 3.297,
  "clauses": [
   {
    "text": "相机",
    "start": 0.0,
    "end": 0.514
   },
   {
    "text": "也从工具",
    "start": 0.674,
    "end": 1.513
   },
   {
    "text": "变成了挂在包上的配饰",
    "start": 1.673,
    "end": 3.297
   }
  ]
 },
 "L29": {
  "dur": 2.433,
  "clauses": [
   {
    "text": "但最有意思的",
    "start": 0.0,
    "end": 1.101
   },
   {
    "text": "是另一个细节",
    "start": 1.261,
    "end": 2.433
   }
  ]
 },
 "L30": {
  "dur": 7.694,
  "clauses": [
   {
    "text": "新宿的相机店发现",
    "start": 0.0,
    "end": 1.427
   },
   {
    "text": "很多年轻人冲洗完胶卷",
    "start": 1.587,
    "end": 3.451
   },
   {
    "text": "不要照片",
    "start": 3.611,
    "end": 4.413
   },
   {
    "text": "也不要底片",
    "start": 4.573,
    "end": 5.506
   },
   {
    "text": "只要电子版",
    "start": 5.666,
    "end": 6.572
   },
   {
    "text": "传到手机上",
    "start": 6.732,
    "end": 7.694
   }
  ]
 },
 "L31": {
  "dur": 1.711,
  "clauses": [
   {
    "text": "他们并没有逃离手机",
    "start": 0.0,
    "end": 1.711
   }
  ]
 },
 "L32": {
  "dur": 4.524,
  "clauses": [
   {
    "text": "他们只是想让手机里的生活",
    "start": 0.0,
    "end": 2.184
   },
   {
    "text": "看起来",
    "start": 2.344,
    "end": 2.991
   },
   {
    "text": "像是真的活过",
    "start": 3.151,
    "end": 4.524
   }
  ]
 },
 "L33": {
  "dur": 4.67,
  "clauses": [
   {
    "text": "所以",
    "start": 0.0,
    "end": 0.62
   },
   {
    "text": "日本年轻人买回去的",
    "start": 0.78,
    "end": 2.707
   },
   {
    "text": "也许不是亿台旧相机",
    "start": 2.867,
    "end": 4.67
   }
  ]
 },
 "L34": {
  "dur": 4.258,
  "clauses": [
   {
    "text": "而是一点慢",
    "start": 0.0,
    "end": 1.176
   },
   {
    "text": "一点不完美",
    "start": 1.336,
    "end": 2.402
   },
   {
    "text": "和一个值得等待的理由",
    "start": 2.562,
    "end": 4.258
   }
  ]
 },
 "L35": {
  "dur": 3.146,
  "clauses": [
   {
    "text": "你上移次等亿张照片",
    "start": 0.0,
    "end": 1.898
   },
   {
    "text": "是什么时候",
    "start": 2.058,
    "end": 3.146
   }
  ]
 }
}